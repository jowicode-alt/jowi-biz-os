rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
  function hasProfile() { return signedIn() && exists(userPath(request.auth.uid)); }
  function isSuperAdmin() { return hasProfile() && profile().email == 'fwizzard10@gmail.com' && profile().role == 'super_admin' && profile().status == 'active'; }
  function profile() { return get(userPath(request.auth.uid)).data; }
  function memberPath(id, uid) { return /databases/$(database)/documents/institutions/$(id)/members/$(uid); }
  function studentPath(id, uid) { return /databases/$(database)/documents/institutions/$(id)/students/$(uid); }
  function hasOwnStudent(id) { return signedIn() && exists(studentPath(id, request.auth.uid)); }
  function ownStudent(id) { return get(studentPath(id, request.auth.uid)).data; }
  function isInstitutionStaff(id) { return inInstitution(id) && memberRole(id) in ['owner','institution_admin','campus_admin','lecturer']; }
  function isInstitutionWideStaff(id) { return inInstitution(id) && memberRole(id) in ['owner','institution_admin']; }
  function canStaffReadCampus(id, campusId) { return inInstitution(id) && memberRole(id) in ['campus_admin','lecturer'] && assignedCampus(id) == campusId; }
  function canStudentReadCampus(id, campusId) { return inInstitution(id) && memberRole(id) == 'student' && hasOwnStudent(id) && ownStudent(id).campusId == campusId; }
  function canStudentReadClass(id, classId) { return inInstitution(id) && memberRole(id) == 'student' && hasOwnStudent(id) && ownStudent(id).classId == classId; }
  function enrolmentPath(id, uid, courseUnitId) { return /databases/$(database)/documents/institutions/$(id)/enrolments/$(uid + '_' + courseUnitId); }
  function validFeedEnrolment(id,studentUid,session,student) {
   let unit=session.get('courseUnitId','');
   let enrolRef=enrolmentPath(id,studentUid,unit);
   let hasEnrol=unit is string&&unit.size()>0&&exists(enrolRef);
   let enrol=hasEnrol?get(enrolRef).data:{};
   let cohort=enrol.get('studyYear','')+'__'+enrol.get('academicYearId','')+'__'+enrol.get('semesterId','');
   let years=session.get('studyYears',[session.get('studyYear','')]);
   let semesters=session.get('semesterIds',[session.get('semesterId','')]);
   let keys=session.get('cohortKeys',[cohort]);
   return hasEnrol&&enrol.get('status','')=='active'&&enrol.get('studentUid','')==studentUid
    &&enrol.get('courseUnitId','')==unit&&enrol.get('campusId','')==session.get('campusId','')
    &&enrol.get('academicYearId','')==session.get('academicYearId','')
    &&years is list&&years.hasAny([enrol.get('studyYear','')])
    &&semesters is list&&semesters.hasAny([enrol.get('semesterId','')])
    &&keys is list&&keys.hasAny([cohort])
    &&(session.get('sessionType','')!='class'||session.get('classId','')==student.get('classId',''))
    &&(session.get('sessionType','')=='class'||session.get('sessionGroupMode','combined')=='combined'||enrol.get('teachingGroupId','')==session.get('teachingGroupId',''));
  }
  function validFeedSession(id,studentUid,session,student) {
   return canManageSession(id,session)&&session.get('createdBy','')==request.auth.uid
    &&session.get('status','')=='active'&&student.get('status','')=='active'
    &&student.get('campusId','')==session.get('campusId','')
    &&validFeedEnrolment(id,studentUid,session,student);
  }
  function validStudentFeedCreate(id,studentUid,sessionId) {
   let sessionRef=/databases/$(database)/documents/institutions/$(id)/sessions/$(sessionId);
   let studentRef=studentPath(id,studentUid);
   let sessionExists=exists(sessionRef);
   let studentExists=exists(studentRef);
   let session=sessionExists?get(sessionRef).data:{};
   let student=studentExists?get(studentRef).data:{};
   return sessionExists&&studentExists&&validFeedSession(id,studentUid,session,student);
  }
  function canStudentReadSession(id) {
   let session = resource.data;
   let uid = request.auth == null ? 'no-auth' : request.auth.uid;
   let unitId = session.get('courseUnitId', '');
   let hasUnit = unitId is string && unitId.size() > 0;
   let enrolRef = enrolmentPath(id, uid, unitId);
   let student = exists(studentPath(id, uid)) ? get(studentPath(id, uid)).data : {};
   let enrol = hasUnit && exists(enrolRef) ? get(enrolRef).data : {};
   let sessionType = session.get('sessionType', session.keys().hasAny(['classId']) ? 'class' : 'course-unit');
   let classMatches = session.get('classId', '') == student.get('classId', '')
    && session.get('campusId', '') == student.get('campusId', '');
   let groupMatches = session.get('sessionGroupMode', 'combined') == 'combined'
    || (session.get('sessionGroupMode', '') == 'separate'
     && enrol.get('teachingGroupId', '') == session.get('teachingGroupId', ''));
   return signedIn() && inInstitution(id) && memberRole(id) == 'student'
    && exists(studentPath(id, uid))
    && (!hasUnit
      ? classMatches
      : exists(enrolRef) && enrol.get('status', '') == 'active'
       && enrol.get('campusId', '') == session.get('campusId', '')
       && enrol.get('campusId', '') == student.get('campusId', '')
       && session.get('studyYears', [session.get('studyYear','')]) is list
       && session.get('semesterIds', [session.get('semesterId','')]) is list
       && session.get('cohortKeys', [session.get('studyYear','') + '__' + session.get('academicYearId','') + '__' + session.get('semesterId','')]) is list
       && session.get('studyYears', [session.get('studyYear','')]).hasAny([enrol.get('studyYear','')])
       && session.get('semesterIds', [session.get('semesterId','')]).hasAny([enrol.get('semesterId','')])
       && session.get('cohortKeys', [session.get('studyYear','') + '__' + session.get('academicYearId','') + '__' + session.get('semesterId','')]).hasAny([enrol.get('studyYear','') + '__' + enrol.get('academicYearId','') + '__' + enrol.get('semesterId','')])
       && enrol.get('academicYearId', '') == session.get('academicYearId', '')
       && (sessionType == 'class' ? classMatches : sessionType == 'course-unit' && groupMatches));
  }
  function inInstitution(id) {
   let userRef = userPath(request.auth.uid);
   let memberRef = memberPath(id, request.auth.uid);
   let userExists = signedIn() && exists(userRef);
   let memberExists = signedIn() && exists(memberRef);
   let user = userExists ? get(userRef).data : {};
   return signedIn() && userExists && memberExists && user.get('institutionId','') == id;
  }
  function memberRole(id) { return get(memberPath(id, request.auth.uid)).data.role; }
  function canAdminMembers(id) { return inInstitution(id) && memberRole(id) in ['owner','institution_admin']; }
  function invitePath(email, id) { return /databases/$(database)/documents/invitations/$(email + '__' + id); }
  function hasAcceptedInvite(id, uid, targetRole, code) {
   return signedIn() && request.auth.uid == uid && request.auth.token.email is string
    && exists(invitePath(request.auth.token.email, id))
    && get(invitePath(request.auth.token.email, id)).data.email == request.auth.token.email
    && get(invitePath(request.auth.token.email, id)).data.institutionId == id
    && get(invitePath(request.auth.token.email, id)).data.institutionCode == code
    && get(invitePath(request.auth.token.email, id)).data.role == targetRole
    && get(invitePath(request.auth.token.email, id)).data.status == 'pending'
    && existsAfter(invitePath(request.auth.token.email, id))
    && getAfter(invitePath(request.auth.token.email, id)).data.status == 'accepted'
    && getAfter(invitePath(request.auth.token.email, id)).data.acceptedUid == uid;
  }
  function assignedCampus(id) { return get(memberPath(id, request.auth.uid)).data.assignedCampusId; }
  function canCreateMember(id, targetRole, campusId) {
   return inInstitution(id) && ((memberRole(id) == 'owner' && targetRole in ['institution_admin','campus_admin','lecturer','student']) || (memberRole(id) == 'institution_admin' && targetRole in ['campus_admin','lecturer','student']) || (memberRole(id) == 'campus_admin' && targetRole in ['lecturer','student'] && assignedCampus(id) == campusId) || (memberRole(id) == 'lecturer' && targetRole == 'student' && assignedCampus(id) == campusId));
  }
  function canManageCampus(id,campusId) {
   let userRef = userPath(request.auth.uid);
   let memberRef = memberPath(id,request.auth.uid);
   let userFound = signedIn() && exists(userRef);
   let memberFound = signedIn() && exists(memberRef);
   let user = userFound ? get(userRef).data : {};
   let member = memberFound ? get(memberRef).data : {};
   return signedIn() && userFound && memberFound && user.get('institutionId','') == id
    && (member.get('role','') in ['owner','institution_admin']
     || (member.get('role','') == 'campus_admin' && member.get('assignedCampusId','') == campusId));
  }
  function classCampus(id,classId) { return get(/databases/$(database)/documents/institutions/$(id)/classes/$(classId)).data.campusId; }
  function canManageClass(id,classId) {
   let userRef = userPath(request.auth.uid);
   let memberRef = memberPath(id,request.auth.uid);
   let classRef = /databases/$(database)/documents/institutions/$(id)/classes/$(classId);
   let userFound = signedIn() && exists(userRef);
   let memberFound = signedIn() && exists(memberRef);
   let classFound = exists(classRef);
   let user = userFound ? get(userRef).data : {};
   let member = memberFound ? get(memberRef).data : {};
   let classData = classFound ? get(classRef).data : {};
   return signedIn() && userFound && memberFound && classFound && user.get('institutionId','') == id
    && (member.get('role','') in ['owner','institution_admin']
     || (member.get('role','') in ['campus_admin','lecturer']
      && member.get('assignedCampusId','') == classData.get('campusId','')));
  }
    function canTeachCampus(id,campusId) {
   let userRef = userPath(request.auth.uid);
   let memberRef = memberPath(id,request.auth.uid);
   let userFound = signedIn() && exists(userRef);
   let memberFound = signedIn() && exists(memberRef);
   let user = userFound ? get(userRef).data : {};
   let member = memberFound ? get(memberRef).data : {};
   return signedIn() && userFound && memberFound && user.get('institutionId','') == id
    && (member.get('role','') in ['owner','institution_admin']
     || (member.get('role','') in ['campus_admin','lecturer']
      && member.get('assignedCampusId','') == campusId));
  }
  function canManageSession(id,session) {
   let userRef = userPath(request.auth.uid);
   let memberRef = memberPath(id,request.auth.uid);
   let userFound = signedIn() && exists(userRef);
   let memberFound = signedIn() && exists(memberRef);
   let user = userFound ? get(userRef).data : {};
   let member = memberFound ? get(memberRef).data : {};
   return signedIn() && userFound && memberFound && user.get('institutionId','') == id
    && (member.get('role','') in ['owner','institution_admin']
     || (member.get('role','') == 'campus_admin' && member.get('assignedCampusId','') == session.get('campusId',''))
     || (member.get('role','') == 'lecturer' && member.get('assignedCampusId','') == session.get('campusId','') && session.get('createdBy','') == request.auth.uid));
  }
  function validCourseUnitSessionCreate(id,data) {
   let unitId = data.get('courseUnitId','');
   let yearId = data.get('academicYearId','');
   let semesterId = data.get('semesterId','');
   return unitId is string && unitId.size() > 0
    && get(/databases/$(database)/documents/institutions/$(id)/courseUnits/$(unitId)).data.get('status','') == 'active'
    && yearId is string && yearId.size() > 0
    && get(/databases/$(database)/documents/institutions/$(id)/academicYears/$(yearId)).data.get('status','') == 'active'
    && semesterId is string && semesterId.size() > 0
    && get(/databases/$(database)/documents/institutions/$(id)/semesters/$(semesterId)).data.get('status','') == 'active'
    && get(/databases/$(database)/documents/institutions/$(id)/semesters/$(semesterId)).data.get('academicYearId','') == yearId
    && data.get('teachingGroupId','') is string
    && data.get('studyYear','') is string && data.get('studyYear','').size() > 0
    && data.get('studyYears',[]) is list && data.get('studyYears',[]).size() > 0 && data.get('studyYears',[]).size() <= 10
    && data.get('semesterIds',[]) is list && data.get('semesterIds',[]).size() > 0 && data.get('semesterIds',[]).size() <= 10
    && data.get('cohortKeys',[]) is list && data.get('cohortKeys',[]).size() == data.get('studyYears',[]).size() * data.get('semesterIds',[]).size()
    && data.get('studyYears',[]).hasAny([data.get('studyYear','')])
    && data.get('semesterIds',[]).hasAny([data.get('semesterId','')])
    && data.get('sessionGroupMode','') in ['combined','separate']
    && ((data.get('sessionGroupMode','') == 'combined' && data.get('teachingGroupId','') == '')
     || (data.get('sessionGroupMode','') == 'separate'
      && data.get('teachingGroupId','').size() > 0
      && exists(/databases/$(database)/documents/institutions/$(id)/teachingGroups/$(data.get('teachingGroupId','')))
      && get(/databases/$(database)/documents/institutions/$(id)/teachingGroups/$(data.get('teachingGroupId',''))).data.get('campusId','') == data.get('campusId','')
      && get(/databases/$(database)/documents/institutions/$(id)/teachingGroups/$(data.get('teachingGroupId',''))).data.get('status','') == 'active'));
  }
  function validClassSessionCreate(id,data) {
   let classId = data.get('classId','');
   let unitId = data.get('courseUnitId','');
   let yearId = data.get('academicYearId','');
   let semesterId = data.get('semesterId','');
   return classId is string && classId.size() > 0
    && get(/databases/$(database)/documents/institutions/$(id)/classes/$(classId)).data.get('campusId','') == data.get('campusId','')
    && unitId is string && unitId.size() > 0
    && get(/databases/$(database)/documents/institutions/$(id)/courseUnits/$(unitId)).data.get('status','') == 'active'
    && yearId is string && yearId.size() > 0
    && get(/databases/$(database)/documents/institutions/$(id)/academicYears/$(yearId)).data.get('status','') == 'active'
    && semesterId is string && semesterId.size() > 0
    && get(/databases/$(database)/documents/institutions/$(id)/semesters/$(semesterId)).data.get('status','') == 'active'
    && get(/databases/$(database)/documents/institutions/$(id)/semesters/$(semesterId)).data.get('academicYearId','') == yearId
    && data.get('studyYear','') is string && data.get('studyYear','').size() > 0;
  }
  function validSessionCreate(id) {
   let data = request.resource.data;
   let campusId = data.get('campusId','');
   let unitId = data.get('courseUnitId','');
   let classId = data.get('classId','');
   let unitSession = unitId is string && unitId.size() > 0;
   let classSession = classId is string && classId.size() > 0;
   return canTeachCampus(id,campusId) && data.get('createdBy','') == request.auth.uid
    && data.get('status','') == 'active' && ((classSession && data.get('sessionType','') == 'class') || (!classSession && data.get('sessionType','') == 'course-unit')) && data.get('title','') is string && data.get('title','').size() > 0
    && campusId is string && campusId.size() > 0
    && ((classSession && validClassSessionCreate(id,data)) || (!classSession && unitSession && validCourseUnitSessionCreate(id,data)))
    && data.get('durationMinutes',0) in [30,45,60,90,120] && data.get('requiresGps',false) is bool
    && (!data.get('requiresGps',false) || (data.get('location',null) is latlng
     && data.get('radiusMeters',0) is number && data.get('radiusMeters',0) >= 25 && data.get('radiusMeters',0) <= 500))
    && data.get('createdAt',null) is timestamp && data.get('openedAt',0) is number && data.get('expiresAt',0) is number
    && data.expiresAt > data.openedAt && data.expiresAt - data.openedAt == data.durationMinutes * 60000
    && data.get('activeCode','') is string && data.activeCode.matches('^[0-9]{6}$')
    && data.get('codeUpdatedAt',null) == data.openedAt && data.get('codeVersion',0) == 1
    && data.keys().hasOnly(['title','campusId','sessionType','classId','courseUnitId','studyYear','studyYears','academicYearId','semesterId','semesterIds','cohortKeys','teachingGroupId','sessionGroupMode','status','durationMinutes','requiresGps','location','radiusMeters','createdAt','createdBy','openedAt','expiresAt','activeCode','codeUpdatedAt','codeVersion']);
  }
  match /users/{uid} {
   allow get: if signedIn() && request.auth.uid == uid;
   allow list: if false;
   allow create: if (
     signedIn() && request.auth.uid == uid && request.resource.data.uid == uid
     && request.resource.data.role == 'owner' && request.resource.data.status == 'active'
     && request.resource.data.email == request.auth.token.email
     && request.resource.data.institutionCode is string
     && request.resource.data.institutionCode.matches('^IC-[A-Z0-9]{4}-[A-Z0-9]{4}$')
     && request.resource.data.contact is string && request.resource.data.dateOfBirth is string
     && request.resource.data.gender is string && request.resource.data.photoDataUrl is string
     && request.resource.data.photoDataUrl.size() <= 180000
     && existsAfter(/databases/$(database)/documents/institutions/$(request.resource.data.institutionId))
     && getAfter(/databases/$(database)/documents/institutions/$(request.resource.data.institutionId)).data.ownerId == uid
     && getAfter(/databases/$(database)/documents/institutions/$(request.resource.data.institutionId)).data.institutionCode == request.resource.data.institutionCode
     && request.resource.data.keys().hasOnly(['uid','name','email','contact','dateOfBirth','gender','photoDataUrl','institutionId','institutionCode','role','status','createdAt'])
   ) || (
     signedIn() && request.auth.uid == uid && request.resource.data.uid == uid
     && request.resource.data.email == request.auth.token.email
     && request.resource.data.status == 'active'
     && request.resource.data.institutionId is string
     && request.resource.data.institutionCode == get(/databases/$(database)/documents/institutions/$(request.resource.data.institutionId)).data.institutionCode
     && hasAcceptedInvite(request.resource.data.institutionId, uid, request.resource.data.role, request.resource.data.institutionCode)
     && request.resource.data.createdBy == get(invitePath(request.auth.token.email, request.resource.data.institutionId)).data.createdBy
     && request.resource.data.get('assignedCampusId','') == get(invitePath(request.auth.token.email, request.resource.data.institutionId)).data.get('assignedCampusId','')
     && (request.resource.data.role != 'student' || (request.resource.data.classId == get(invitePath(request.auth.token.email, request.resource.data.institutionId)).data.classId && request.resource.data.studentNumber == get(invitePath(request.auth.token.email, request.resource.data.institutionId)).data.studentNumber && request.resource.data.parentName is string && request.resource.data.parentPhone is string))
     && request.resource.data.name is string && request.resource.data.contact is string
     && request.resource.data.dateOfBirth is string && request.resource.data.gender is string
     && request.resource.data.photoDataUrl is string && request.resource.data.photoDataUrl.size() <= 180000
     && (request.resource.data.role != 'student' || (
       request.resource.data.registeredDeviceId is string
       && existsAfter(/databases/$(database)/documents/institutions/$(request.resource.data.institutionId)/students/$(uid))
       && getAfter(/databases/$(database)/documents/institutions/$(request.resource.data.institutionId)/students/$(uid)).data.authUid == uid
       && getAfter(/databases/$(database)/documents/institutions/$(request.resource.data.institutionId)/students/$(uid)).data.deviceId == request.resource.data.registeredDeviceId
     ))
     && request.resource.data.keys().hasOnly(['uid','name','email','contact','dateOfBirth','gender','photoDataUrl','institutionId','institutionCode','role','status','createdAt','createdBy','assignedCampusId','classId','studentNumber','parentName','parentPhone','registeredDeviceId'])
   );
   allow update: if signedIn() && request.auth.uid == uid
    && request.resource.data.get('email', '') == request.auth.token.get('email', '')
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','email','contact','dateOfBirth','gender','photoDataUrl','institutionCode'])
    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoDataUrl']) || (request.resource.data.photoDataUrl is string && request.resource.data.photoDataUrl.size() <= 180000))
    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['institutionCode']) || (request.resource.data.institutionCode is string && request.resource.data.institutionId is string && get(/databases/$(database)/documents/institutions/$(request.resource.data.institutionId)).data.institutionCode == request.resource.data.institutionCode));
   allow delete: if false;
  }
  match /policyAcceptances/{uid} {
   allow get: if signedIn() && request.auth.uid == uid;
   allow list: if false;
   allow create: if signedIn() && request.auth.uid == uid
    && request.resource.data.uid == uid
    && request.resource.data.acceptedAt is timestamp
    && request.resource.data.acceptedAtClient is string
    && request.resource.data.institutionId is string
    && request.resource.data.institutionCode is string
    && request.resource.data.institutionCode.matches('^IC-[A-Z0-9]{4}-[A-Z0-9]{4}$')
    && (
      (request.resource.data.role == 'owner'
       && request.resource.data.termsVersion == '2026-11-08'
       && request.resource.data.privacyVersion == '2026-11-08'
       && request.resource.data.dpaVersion == '2026-11-08'
       && request.resource.data.keys().hasOnly(['uid','institutionId','institutionCode','role','termsVersion','privacyVersion','dpaVersion','acceptedAt','acceptedAtClient'])
       && existsAfter(/databases/$(database)/documents/institutions/$(request.resource.data.institutionId))
       && getAfter(/databases/$(database)/documents/institutions/$(request.resource.data.institutionId)).data.ownerId == uid
       && getAfter(/databases/$(database)/documents/institutions/$(request.resource.data.institutionId)).data.institutionCode == request.resource.data.institutionCode)
      ||
      (request.resource.data.role in ['student','lecturer','campus_admin','institution_admin']
       && request.resource.data.noticeVersion == '2026-11-08'
       && request.resource.data.keys().hasOnly(['uid','institutionId','institutionCode','role','noticeVersion','acceptedAt','acceptedAtClient'])
       && existsAfter(invitePath(request.auth.token.email, request.resource.data.institutionId))
       && getAfter(invitePath(request.auth.token.email, request.resource.data.institutionId)).data.status == 'accepted'
       && getAfter(invitePath(request.auth.token.email, request.resource.data.institutionId)).data.acceptedUid == uid
       && getAfter(invitePath(request.auth.token.email, request.resource.data.institutionId)).data.institutionCode == request.resource.data.institutionCode)
    );
   allow update, delete: if false;
  }
  match /institutions/{id}/studentSessionFeeds/{studentUid}/sessions/{sessionId} {
   allow get,list: if signedIn()&&request.auth.uid==studentUid&&inInstitution(id)&&memberRole(id)=='student';
   allow create: if request.resource.data.sessionId==sessionId&&request.resource.data.createdBy==request.auth.uid
    &&request.resource.data.campusId is string&&request.resource.data.courseUnitId is string
    &&request.resource.data.createdAt is timestamp
    &&request.resource.data.keys().hasOnly(['sessionId','campusId','courseUnitId','createdBy','createdAt'])
    &&validStudentFeedCreate(id,studentUid,sessionId);
   // Allow only the original session owner to refresh the feed timestamp during safe backfill.
   allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdAt'])
    &&request.resource.data.sessionId==resource.data.sessionId
    &&request.resource.data.campusId==resource.data.campusId
    &&request.resource.data.courseUnitId==resource.data.courseUnitId
    &&request.resource.data.createdBy==resource.data.createdBy
    &&request.resource.data.createdBy==request.auth.uid
    &&request.resource.data.createdAt is timestamp
    &&validStudentFeedCreate(id,studentUid,sessionId);
   allow delete: if false;
  }
  match /institutions/{id}/accessRequests/{uid} {
   allow create, update: if signedIn() && request.auth.uid == uid
    && request.resource.data.uid == uid
    && request.resource.data.email == request.auth.token.email
    && request.resource.data.requestedRole in ['student','lecturer']
    && request.resource.data.status == 'pending'
    && request.resource.data.keys().hasOnly(['uid','name','email','requestedRole','status','createdAt']);
   allow read: if signedIn() && (
    (exists(userPath(request.auth.uid)) && get(userPath(request.auth.uid)).data.institutionId == id
      && get(memberPath(id, request.auth.uid)).data.role in ['owner','institution_admin'])
    || request.auth.uid == uid
   );
   allow update: if signedIn() && exists(userPath(request.auth.uid))
