    match /attendance/{docId} {
    function canReadAttendanceRecord(id) {
    return inInstitution(id) && (
     memberRole(id) in ['owner','institution_admin']
     || (memberRole(id) in ['campus_admin','lecturer'] && ((resource.data.classId is string && assignedCampus(id) == classCampus(id, resource.data.classId)) || (exists(/databases/$(database)/documents/institutions/$(id)/sessions/$(resource.data.sessionId)) && get(/databases/$(database)/documents/institutions/$(id)/sessions/$(resource.data.sessionId)).data.campusId == assignedCampus(id))))
     || (memberRole(id) == 'student' && resource.data.studentId == request.auth.uid)
    );
   }
   allow get: if canReadAttendanceRecord(id);
   allow list: if inInstitution(id) && (
     memberRole(id) in ['owner','institution_admin']
     || (memberRole(id) in ['campus_admin','lecturer'] && ((resource.data.classId is string && assignedCampus(id) == classCampus(id, resource.data.classId)) || (exists(/databases/$(database)/documents/institutions/$(id)/sessions/$(resource.data.sessionId)) && get(/databases/$(database)/documents/institutions/$(id)/sessions/$(resource.data.sessionId)).data.campusId == assignedCampus(id))))
     || (memberRole(id) == 'student' && resource.data.studentId == request.auth.uid)
    );
         function attendancePayloadValid(data, docId) {
      return data.keys().hasOnly(['sessionId','studentId','studentName','studentNumber','classId','courseUnitId','programmeId','studyYear','academicYearId','semesterId','teachingGroupId','enrolmentId','status','deviceId','code','location','accuracyMeters','checkedAt'])
       && data.sessionId is string && data.studentId is string
       && data.studentName is string && data.studentNumber is string
       && data.classId is string && data.status == 'present'
       && data.deviceId is string && data.code is string
       && data.location is latlng && data.accuracyMeters is number
       && data.accuracyMeters >= 0 && data.accuracyMeters <= 100
       && data.checkedAt == request.time
       && request.auth.uid == data.studentId
       && docId == data.sessionId + '_' + data.studentId;
     }
     function attendanceSessionValid(session, data) {
      return session.status == 'active'
       && session.expiresAt > request.time.toMillis()
       && session.activeCode == data.code
       && session.codeUpdatedAt is number
       && session.codeUpdatedAt <= request.time.toMillis()
       && request.time.toMillis() - session.codeUpdatedAt <= 1805000;
     }
     function attendanceLearnerValid(learner, data) {
      return learner.authUid == request.auth.uid
       && learner.status == 'active'
       && learner.deviceId == data.deviceId;
     }
     function attendancePlacementValid(id, data, session) {
      let unitId = data.get('courseUnitId', '');
      let hasUnit = unitId is string && unitId.size() > 0;
      let enrolRef = /databases/$(database)/documents/institutions/$(id)/enrolments/$(data.studentId + '_' + unitId);
      let enrolExists = hasUnit && exists(enrolRef);
      let enrol = enrolExists ? get(enrolRef).data : {};
      let sessionType = session.get('sessionType', session.keys().hasAny(['classId']) ? 'class' : 'course-unit');
      return !hasUnit
       ? session.get('classId', '') == data.classId
       : enrolExists
        && session.get('courseUnitId', '') == unitId
        && data.get('enrolmentId', '') == data.studentId + '_' + unitId
        && enrol.get('status', '') == 'active'
        && enrol.get('programmeId', '') == data.get('programmeId', '')
        && enrol.get('studyYear', '') == data.get('studyYear', '')
        && enrol.get('academicYearId', '') == data.get('academicYearId', '')
        && enrol.get('semesterId', '') == data.get('semesterId', '')
        && session.get('studyYears', [session.get('studyYear','')]).hasAny([data.get('studyYear','')])
        && session.get('semesterIds', [session.get('semesterId','')]).hasAny([data.get('semesterId','')])
        && session.get('cohortKeys', [session.get('studyYear','') + '__' + session.get('academicYearId','') + '__' + session.get('semesterId','')]).hasAny([data.get('studyYear','') + '__' + data.get('academicYearId','') + '__' + data.get('semesterId','')])
        && session.get('academicYearId', '') == data.get('academicYearId', '')
        && enrol.get('campusId', '') == session.get('campusId', '')
        && enrol.get('teachingGroupId', '') == data.get('teachingGroupId', '')
        && ((sessionType == 'class' && session.get('classId', '') == data.classId)
         || (sessionType == 'course-unit'
          && (session.get('sessionGroupMode', 'combined') == 'combined'
           || (session.get('sessionGroupMode', '') == 'separate'
            && enrol.get('teachingGroupId', '') == session.get('teachingGroupId', '')))));
     }
     function attendanceGpsValid(session, data) {
      return !session.get('requiresGps', false)
       || (session.get('location', null) is latlng
        && data.location.distance(session.location) <= session.get('radiusMeters', 0));
     }
     function validAttendanceCreate(id, docId) {
      let data = request.resource.data;
      let sessionRef = /databases/$(database)/documents/institutions/$(id)/sessions/$(data.sessionId);
      let learnerRef = /databases/$(database)/documents/institutions/$(id)/students/$(data.studentId);
      let sessionFound = exists(sessionRef);
      let learnerFound = exists(learnerRef);
      let session = sessionFound ? get(sessionRef).data : {};
      let learner = learnerFound ? get(learnerRef).data : {};
      return attendancePayloadValid(data, docId)
       && sessionFound && attendanceSessionValid(session, data)
       && learnerFound && attendanceLearnerValid(learner, data)
       && learner.get('campusId', '') == session.get('campusId', '')
       && attendanceGpsValid(session, data)
       && attendancePlacementValid(id, data, session)
       && !exists(/databases/$(database)/documents/institutions/$(id)/attendance/$(docId));
     }
     allow create: if validAttendanceCreate(id, docId);
allow update, delete: if false;
   }
   match /absences/{docId} {
    function absencePlacementValid(id,data,session,student) {
     let unitId = data.get('courseUnitId','');
     let hasUnit = unitId is string && unitId.size() > 0;
     let enrolRef = enrolmentPath(id, data.studentId, unitId);
     let enrolExists = hasUnit && exists(enrolRef);
     let enrol = enrolExists ? get(enrolRef).data : {};
     let sessionType = session.get('sessionType',session.keys().hasAny(['classId']) ? 'class' : 'course-unit');
     let classMatches = data.get('classId','') == session.get('classId','')
      && data.get('classId','') == student.get('classId','');
     let cohortMatches = enrol.get('studyYear','') == data.get('studyYear','')
      && session.get('studyYears',[session.get('studyYear','')]).hasAny([enrol.get('studyYear','')])
      && enrol.get('academicYearId','') == data.get('academicYearId','')
      && enrol.get('academicYearId','') == session.get('academicYearId','')
      && session.get('semesterIds',[session.get('semesterId','')]).hasAny([enrol.get('semesterId','')])
      && enrol.get('semesterId','') == data.get('semesterId','')
      && session.get('cohortKeys',[session.get('studyYear','') + '__' + session.get('academicYearId','') + '__' + session.get('semesterId','')]).hasAny([enrol.get('studyYear','') + '__' + enrol.get('academicYearId','') + '__' + enrol.get('semesterId','')]);
     let groupMatches = session.get('sessionGroupMode','combined') == 'combined'
      || (session.get('sessionGroupMode','') == 'separate'
       && enrol.get('teachingGroupId','') == session.get('teachingGroupId',''));
     return !hasUnit
      ? classMatches
      : session.get('courseUnitId','') == unitId && enrolExists
       && enrol.get('status','') == 'active'
       && enrol.get('campusId','') == session.get('campusId','')
       && enrol.get('programmeId','') == data.get('programmeId','')
       && data.get('enrolmentId','') == data.studentId + '_' + unitId
       && cohortMatches
       && (sessionType == 'class' ? classMatches : sessionType == 'course-unit' && groupMatches);
