rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(businessId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid));
    }

    function isOwner(businessId) {
      return signedIn() &&
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /businesses/{businessId} {
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid;
      // Using resource.data lets Firestore prove owner-only collection queries from ownerId filters.
      allow read: if (signedIn() && resource.data.ownerId == request.auth.uid) ||
        isMember(businessId);
      allow update: if isOwner(businessId);
      allow delete: if false;

      match /members/{memberId} {
        allow read: if signedIn() &&
          (request.auth.uid == memberId || isOwner(businessId));
        allow create, update: if isOwner(businessId) &&
          request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'role', 'createdAt']) &&
          request.resource.data.uid == memberId;
        allow delete: if isOwner(businessId) && memberId != request.auth.uid;
      }

      match /{collection}/{documentId} {
        allow read: if isMember(businessId) || isOwner(businessId);
        allow create, update, delete: if isMember(businessId) || isOwner(businessId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}