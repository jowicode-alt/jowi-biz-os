    function validAbsenceCreate(id,docId) {
     let data = request.resource.data;
     let sessionRef = /databases/$(database)/documents/institutions/$(id)/sessions/$(data.get('sessionId',''));
     let studentRef = /databases/$(database)/documents/institutions/$(id)/students/$(data.get('studentId',''));
     let sessionFound = exists(sessionRef);
     let studentFound = exists(studentRef);
     let session = sessionFound ? get(sessionRef).data : {};
     let student = studentFound ? get(studentRef).data : {};
     return signedIn() && inInstitution(id) && data.keys().hasOnly(['sessionId','studentId','studentName','studentNumber','classId','courseUnitId','programmeId','studyYear','academicYearId','semesterId','teachingGroupId','enrolmentId','status','finalizedBy','finalizedAt'])
      && data.get('status','') == 'absent' && data.get('finalizedBy','') == request.auth.uid
      && data.get('finalizedAt',null) == request.time
      && docId == data.get('sessionId','') + '_' + data.get('studentId','')
      && sessionFound && session.get('createdBy','') == request.auth.uid
      && session.get('status','') == 'active'
      && studentFound && student.get('authUid','') == data.get('studentId','')
      && student.get('status','') == 'active'
      && student.get('campusId','') == session.get('campusId','')
      && absencePlacementValid(id,data,session,student);
    }
    
    allow get, list: if inInstitution(id) && (
     memberRole(id) in ['owner','institution_admin']
     || (memberRole(id) in ['campus_admin','lecturer'] && exists(/databases/$(database)/documents/institutions/$(id)/sessions/$(resource.data.sessionId)) && get(/databases/$(database)/documents/institutions/$(id)/sessions/$(resource.data.sessionId)).data.campusId == assignedCampus(id))
     || (memberRole(id) == 'student' && resource.data.studentId == request.auth.uid)
    );
    allow create: if validAbsenceCreate(id,docId);
    allow update, delete: if false;
   }
