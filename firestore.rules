rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
  function hasProfile() { return signedIn() && exists(userPath(request.auth.uid)); }
  function profile() { return get(userPath(request.auth.uid)).data; }
  function memberPath(id, uid) { return /databases/$(database)/documents/institutions/$(id)/members/$(uid); }
  function inInstitution(id) { return hasProfile() && profile().institutionId == id && exists(memberPath(id, request.auth.uid)); }
  function memberRole(id) { return get(memberPath(id, request.auth.uid)).data.role; }
  function canManage(id) { return inInstitution(id) && memberRole(id) in ['owner','institution_admin','campus_admin']; }
  function canAdminMembers(id) { return inInstitution(id) && memberRole(id) in ['owner','institution_admin']; }
  function assignedCampus(id) { return get(memberPath(id, request.auth.uid)).data.assignedCampusId; }
  function canManageCampus(id, campusId) {
   return inInstitution(id) && (
    memberRole(id) in ['owner','institution_admin']
    || (memberRole(id) == 'campus_admin' && assignedCampus(id) == campusId)
   );
  }
  function classCampus(id, classId) {
   return get(/databases/$(database)/documents/institutions/$(id)/classes/$(classId)).data.campusId;
  }
  function canManageClass(id, classId) {
   return canManageCampus(id, classCampus(id, classId));
  }
  function canTeach(id) { return inInstitution(id) && memberRole(id) in ['owner','institution_admin','campus_admin','lecturer']; }
  function validSessionCreate(id) {
   return canTeach(id)
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.status == 'active'
    && request.resource.data.title is string
    && request.resource.data.title.size() > 0
    && request.resource.data.classId is string
    && request.resource.data.durationMinutes in [30,45,60,90,120]
    && request.resource.data.requiresGps is bool
    && (!request.resource.data.requiresGps || (request.resource.data.location is latlng && request.resource.data.radiusMeters is number && request.resource.data.radiusMeters >= 25 && request.resource.data.radiusMeters <= 500))
    && request.resource.data.createdAt is timestamp
    && request.resource.data.openedAt is number
    && request.resource.data.expiresAt is number
    && request.resource.data.expiresAt > request.resource.data.openedAt
    && request.resource.data.expiresAt - request.resource.data.openedAt == request.resource.data.durationMinutes * 60000
    && request.resource.data.activeCode is string
    && request.resource.data.activeCode.matches('^[0-9]{6}$')
    && request.resource.data.codeUpdatedAt == request.resource.data.openedAt
    && request.resource.data.codeVersion == 1
    && request.resource.data.keys().hasOnly(['title','classId','status','durationMinutes','requiresGps','location','radiusMeters','createdAt','createdBy','openedAt','expiresAt','activeCode','codeUpdatedAt','codeVersion']);
  }
  match /users/{uid} {
   allow get: if signedIn() && request.auth.uid == uid;
   allow list: if false;
   allow create: if (signedIn() && request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.role == 'owner' && request.resource.data.status == 'active' && request.resource.data.keys().hasOnly(['uid','name','email','institutionId','role','status','createdAt'])) || (signedIn() && canAdminMembers(request.resource.data.institutionId) && request.resource.data.uid == uid && request.resource.data.role in ['institution_admin','campus_admin','lecturer','student'] && request.resource.data.status == 'active' && existsAfter(memberPath(request.resource.data.institutionId, uid)) && getAfter(memberPath(request.resource.data.institutionId, uid)).data.role == request.resource.data.role && request.resource.data.keys().hasOnly(['uid','name','email','institutionId','role','status','createdAt']));
   allow update: if signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','email']);
   allow delete: if false;
  }
  match /institutions/{id} {
   allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.keys().hasOnly(['name','type','country','timezone','ownerId','status','createdAt','createdBy']);
   allow read: if inInstitution(id);
   allow update: if canAdminMembers(id) && request.resource.data.ownerId == resource.data.ownerId;
   allow delete: if false;
   match /members/{uid} {
    allow read: if inInstitution(id) && (request.auth.uid == uid || canManage(id));
    allow create: if (signedIn() && request.auth.uid == uid && get(/databases/$(database)/documents/institutions/$(id)).data.ownerId == request.auth.uid && request.resource.data.uid == uid && request.resource.data.role == 'owner' && request.resource.data.status == 'active' && request.resource.data.keys().hasOnly(['uid','name','email','role','status','createdAt'])) || (canAdminMembers(id) && uid != request.auth.uid && request.resource.data.uid == uid && request.resource.data.role in ['institution_admin','campus_admin','lecturer','student'] && request.resource.data.status == 'active' && request.resource.data.keys().hasOnly(['uid','name','email','role','status','createdAt','assignedCampusId']) && (request.resource.data.role != 'campus_admin' || (request.resource.data.assignedCampusId is string && exists(/databases/$(database)/documents/institutions/$(id)/campuses/$(request.resource.data.assignedCampusId))));
    allow update: if canAdminMembers(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','email','role','status']);
    allow delete: if false;
   }
   match /campuses/{docId} {
    allow read: if inInstitution(id);
    allow create, update: if canManageCampus(id, docId) && request.resource.data.keys().hasOnly(['name','city','timezone','createdAt','createdBy']);
    allow delete: if false;
   }
   match /classes/{docId} {
    allow read: if inInstitution(id);
    allow create, update: if canManageCampus(id, request.resource.data.campusId) && request.resource.data.keys().hasOnly(['name','code','campusId','createdAt','createdBy']);
    allow delete: if false;
   }
   match /students/{docId} {
    allow read: if inInstitution(id);
    allow create, update: if canManageClass(id, request.resource.data.classId) && request.resource.data.keys().hasOnly(['name','studentNumber','classId','authUid','deviceId','status','createdAt','createdBy']);
    allow delete: if false;
   }
   match /sessions/{docId} {
    allow read: if inInstitution(id);
    allow create: if validSessionCreate(id) && canManageClass(id, request.resource.data.classId);
    allow update: if canTeach(id) && canManageClass(id, resource.data.classId) && (
      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeCode','codeUpdatedAt','codeVersion'])
       && resource.data.status == 'active' && resource.data.createdBy == request.auth.uid
       && request.resource.data.activeCode is string && request.resource.data.activeCode.matches('^[0-9]{6}$')
       && request.resource.data.codeUpdatedAt is number
       && request.resource.data.codeUpdatedAt >= resource.data.codeUpdatedAt + 25000
       && request.resource.data.codeUpdatedAt <= request.time.toMillis() + 5000
       && request.resource.data.codeVersion == resource.data.codeVersion + 1)
      ||
      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','closedAt','closedBy'])
       && request.resource.data.status == 'closed' && resource.data.status == 'active'
       && resource.data.createdBy == request.auth.uid && request.resource.data.closedBy == request.auth.uid
       && request.resource.data.closedAt is number)
    );
    allow delete: if false;
   }
   match /attendance/{docId} {
    allow read: if inInstitution(id);
    allow create: if (
      request.resource.data.keys().hasOnly(['sessionId','studentId','studentName','studentNumber','classId','status','deviceId','code','location','accuracyMeters','checkedAt'])
      && request.resource.data.sessionId is string && request.resource.data.studentId is string
      && request.resource.data.studentName is string && request.resource.data.studentNumber is string
      && request.resource.data.classId is string && request.resource.data.status == 'present'
      && request.resource.data.deviceId is string && request.resource.data.code is string
      && request.resource.data.location is latlng && request.resource.data.accuracyMeters is number
      && request.resource.data.accuracyMeters <= 100 && request.resource.data.checkedAt == request.time
      && docId == request.resource.data.sessionId + '_' + request.resource.data.studentId
      && exists(/databases/$(database)/documents/institutions/$(id)/sessions/$(request.resource.data.sessionId))
      && get(/databases/$(database)/documents/institutions/$(id)/sessions/$(request.resource.data.sessionId)).data.status == 'active'
      && get(/databases/$(database)/documents/institutions/$(id)/sessions/$(request.resource.data.sessionId)).data.expiresAt > request.time.toMillis()
      && get(/databases/$(database)/documents/institutions/$(id)/sessions/$(request.resource.data.sessionId)).data.classId == request.resource.data.classId
      && get(/databases/$(database)/documents/institutions/$(id)/sessions/$(request.resource.data.sessionId)).data.activeCode == request.resource.data.code
      && request.time.toMillis() - get(/databases/$(database)/documents/institutions/$(id)/sessions/$(request.resource.data.sessionId)).data.codeUpdatedAt <= 35000
      && exists(/databases/$(database)/documents/institutions/$(id)/students/$(request.resource.data.studentId))
      && get(/databases/$(database)/documents/institutions/$(id)/students/$(request.resource.data.studentId)).data.authUid == request.auth.uid
      && get(/databases/$(database)/documents/institutions/$(id)/students/$(request.resource.data.studentId)).data.status == 'active'
      && get(/databases/$(database)/documents/institutions/$(id)/students/$(request.resource.data.studentId)).data.deviceId == request.resource.data.deviceId
      && get(/databases/$(database)/documents/institutions/$(id)/students/$(request.resource.data.studentId)).data.classId == request.resource.data.classId
      && (!get(/databases/$(database)/documents/institutions/$(id)/sessions/$(request.resource.data.sessionId)).data.requiresGps
        || (get(/databases/$(database)/documents/institutions/$(id)/sessions/$(request.resource.data.sessionId)).data.location is latlng
          && request.resource.data.location.distance(get(/databases/$(database)/documents/institutions/$(id)/sessions/$(request.resource.data.sessionId)).data.location)
            <= get(/databases/$(database)/documents/institutions/$(id)/sessions/$(request.resource.data.sessionId)).data.radiusMeters))
      && !exists(/databases/$(database)/documents/institutions/$(id)/attendance/$(request.resource.data.sessionId + '_' + request.resource.data.studentId))
    ) || (
      canTeach(id)
      && request.resource.data.keys().hasOnly(['sessionId','studentId','studentName','studentNumber','classId','status','markedBy','markedAt'])
      && request.resource.data.sessionId is string && request.resource.data.studentId is string
      && request.resource.data.studentName is string && request.resource.data.studentNumber is string
      && request.resource.data.classId is string && request.resource.data.status == 'present'
      && request.resource.data.markedBy == request.auth.uid && request.resource.data.markedAt == request.time
      && exists(/databases/$(database)/documents/institutions/$(id)/sessions/$(request.resource.data.sessionId))
      && get(/databases/$(database)/documents/institutions/$(id)/sessions/$(request.resource.data.sessionId)).data.status == 'active'
      && get(/databases/$(database)/documents/institutions/$(id)/sessions/$(request.resource.data.sessionId)).data.classId == request.resource.data.classId
      && exists(/databases/$(database)/documents/institutions/$(id)/students/$(request.resource.data.studentId))
      && get(/databases/$(database)/documents/institutions/$(id)/students/$(request.resource.data.studentId)).data.classId == request.resource.data.classId
    );
    allow update, delete: if false;
   }
   match /{document=**} { allow read, write: if false; }
  }
  match /{document=**} { allow read, write: if false; }
 }
}