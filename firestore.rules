   match /teachingGroups/{docId} {
    allow read: if isInstitutionWideStaff(id) || canStaffReadCampus(id, resource.data.campusId);
    allow create, update: if (canManageCampus(id, request.resource.data.campusId) || (inInstitution(id) && memberRole(id) == 'lecturer' && assignedCampus(id) == request.resource.data.campusId))
      && request.resource.data.keys().hasOnly(['name','code','campusId','programmeIds','status','createdAt','createdBy','archivedAt','archivedBy']);
    allow delete: if false;
   }
   match /enrolmentHistory/{docId} {
    allow read: if isInstitutionWideStaff(id)
      || (inInstitution(id) && memberRole(id) in ['campus_admin','lecturer'] && resource.data.campusId == assignedCampus(id));
    allow create: if (canManageCampus(id, request.resource.data.campusId) || (inInstitution(id) && memberRole(id) == 'lecturer' && assignedCampus(id) == request.resource.data.campusId))
      && request.resource.data.studentUid is string
      && request.resource.data.courseUnitId is string
      && request.resource.data.status in ['active','inactive']
      && request.resource.data.keys().hasOnly(['studentUid','courseUnitId','programmeId','studyYear','academicYearId','semesterId','enrollmentYear','campusId','teachingGroupId','status','createdAt','createdBy','updatedAt','updatedBy','id','archivedAt','archivedBy','archiveReason','endedAt','endedBy']);
    allow update, delete: if false;
   }
   match /enrolments/{docId} {
    allow get: if isInstitutionWideStaff(id)
      || (inInstitution(id) && memberRole(id) in ['campus_admin','lecturer'] && resource.data.campusId == assignedCampus(id))
      || (inInstitution(id) && memberRole(id) == 'student' && resource.data.studentUid == request.auth.uid);
    allow list: if isInstitutionWideStaff(id)
      || (inInstitution(id) && memberRole(id) in ['campus_admin','lecturer'] && resource.data.campusId == assignedCampus(id))
      || (inInstitution(id) && memberRole(id) == 'student' && resource.data.studentUid == request.auth.uid && resource.data.status == 'active');
    allow create, update: if ((canManageCampus(id, request.resource.data.campusId) || (inInstitution(id) && memberRole(id) == 'lecturer' && assignedCampus(id) == request.resource.data.campusId)) || (signedIn() && request.resource.data.studentUid == request.auth.uid && getAfter(invitePath(request.auth.token.email, id)).data.status == 'accepted' && getAfter(invitePath(request.auth.token.email, id)).data.acceptedUid == request.auth.uid && getAfter(invitePath(request.auth.token.email, id)).data.courseUnitIds.hasAny([request.resource.data.courseUnitId]) && getAfter(invitePath(request.auth.token.email, id)).data.programmeId == request.resource.data.programmeId && getAfter(invitePath(request.auth.token.email, id)).data.academicYearId == request.resource.data.academicYearId && getAfter(invitePath(request.auth.token.email, id)).data.semesterId == request.resource.data.semesterId && getAfter(invitePath(request.auth.token.email, id)).data.assignedCampusId == request.resource.data.campusId))
      && request.resource.data.studentUid is string
      && request.resource.data.courseUnitId is string
      && request.resource.data.programmeId is string
      && request.resource.data.academicYearId is string
      && request.resource.data.semesterId is string
      && request.resource.data.status in ['active','inactive']
      && request.resource.data.teachingGroupId is string
      && request.resource.data.get('studyYear','') is string
      && docId == request.resource.data.studentUid + '_' + request.resource.data.courseUnitId
      && existsAfter(/databases/$(database)/documents/institutions/$(id)/students/$(request.resource.data.studentUid))
      && getAfter(/databases/$(database)/documents/institutions/$(id)/students/$(request.resource.data.studentUid)).data.status == 'active'
      && getAfter(/databases/$(database)/documents/institutions/$(id)/students/$(request.resource.data.studentUid)).data.campusId == request.resource.data.campusId
      && exists(/databases/$(database)/documents/institutions/$(id)/courseUnits/$(request.resource.data.courseUnitId))
      && get(/databases/$(database)/documents/institutions/$(id)/courseUnits/$(request.resource.data.courseUnitId)).data.status == 'active'
      && get(/databases/$(database)/documents/institutions/$(id)/courseUnits/$(request.resource.data.courseUnitId)).data.programmeIds is list
      && get(/databases/$(database)/documents/institutions/$(id)/courseUnits/$(request.resource.data.courseUnitId)).data.programmeIds.hasAny([request.resource.data.programmeId])
      && exists(/databases/$(database)/documents/institutions/$(id)/programmes/$(request.resource.data.programmeId))
      && get(/databases/$(database)/documents/institutions/$(id)/programmes/$(request.resource.data.programmeId)).data.status == 'active'
      && exists(/databases/$(database)/documents/institutions/$(id)/academicYears/$(request.resource.data.academicYearId))
      && get(/databases/$(database)/documents/institutions/$(id)/academicYears/$(request.resource.data.academicYearId)).data.status == 'active'
      && exists(/databases/$(database)/documents/institutions/$(id)/semesters/$(request.resource.data.semesterId))
      && get(/databases/$(database)/documents/institutions/$(id)/semesters/$(request.resource.data.semesterId)).data.status == 'active'
      && get(/databases/$(database)/documents/institutions/$(id)/semesters/$(request.resource.data.semesterId)).data.academicYearId == request.resource.data.academicYearId;
    allow delete: if false;
   }
   match /{path=**} { allow read: if isSuperAdmin(); }
  }
  match /platformAuditLogs/{logId} {
   allow get, list: if isSuperAdmin();
   allow create: if isSuperAdmin() && request.resource.data.actorUid == request.auth.uid && request.resource.data.actorEmail == 'fwizzard10@gmail.com' && request.resource.data.action in ['institution_suspended','institution_reactivated'] && request.resource.data.institutionId is string && request.resource.data.timestamp == request.time && request.resource.data.keys().hasOnly(['actorUid','actorEmail','action','institutionId','institutionName','previousStatus','newStatus','timestamp']);
   allow update, delete: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}